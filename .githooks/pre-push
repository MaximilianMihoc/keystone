#!/bin/sh
#
# Refuse a push to main.
#
# main advances only when a pull request is merged on GitHub. Locally you then catch up
# with "git pull", never by pushing.
#
# Git feeds this hook one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main) blocked=1 ;;
    esac
done

if [ "$blocked" -eq 0 ]; then
    exit 0
fi

cat >&2 <<'MSG'

  Push refused: main is not pushed to directly.

  main moves when a pull request merges. Push your branch instead:

      git push -u origin <branch-name>
      gh pr create --fill

  Then bring main up to date the read-only way:

      git switch main && git pull

  If you genuinely need to push main, bypass with:

      git push --no-verify

MSG

exit 1
