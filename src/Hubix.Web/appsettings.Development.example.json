{
  "ConnectionStrings": {
    "HubixDb": "Server=.\\SQLEXPRESS;Database=HubixPortal;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Hubix": {
    "PublicBaseUrl": "http://localhost:5199",

    // Deliberately a .invalid address. RFC 2606 reserves that TLD so it can never
    // resolve. Hubix has not been approached about this system and must not hear
    // about it from an automated reservation notice.
    "SalesInbox": "sales@hubix.invalid"
  },

  "Email": {
    // Opt-in. While false, nothing is transmitted: every message is written to
    // ./outbox exactly as it would have been sent.
    "LiveSendingEnabled": false,

    // Every message is re-addressed here, with the intended recipient kept in the
    // subject and body. Set this to your own address for testing; leave it empty
    // in production.
    "RedirectAllTo": "your.address@example.com",

    // When live sending is on and this is non-empty, only these may be contacted.
    // Empty means everyone, which is what production wants.
    "AllowedRecipients": [],

    // Never contacted, whatever else is configured. Checked before the allow list.
    "BlockedRecipients": [ "*@hubix.ro" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  }
}
