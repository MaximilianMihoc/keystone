{
  "ConnectionStrings": {
    "HubixDb": "Server=.\\SQLEXPRESS;Database=HubixPortal;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Hubix": {
    "PublicBaseUrl": "http://localhost:5001",

    // Deliberately a .invalid address. RFC 2606 reserves that TLD so it can never
    // resolve. Hubix has not been approached about this system and must not hear
    // about it from an automated reservation notice.

    // Both of these, and everything under "Email" below, can be changed by an admin on
    // the Email screen once the app is running. A saved setting wins over this file and
    // applies to the next message, so this is only what a fresh install starts from.
    "SalesInbox": "sales@hubix.invalid"
  },

  // The mail provider. Leave the key empty and no live sender is registered at all, whatever
  // the Email screen says — messages keep going to ./outbox. Never put the key in this file:
  //   dotnet user-secrets set "Resend:ApiKey" "re_..." --project src/Hubix.Web
  // locally, and the host's own secret store in production.
  "Resend": {
    "ApiKey": ""
  },

  // What a fresh install starts from. Once anything is saved on the Email screen, that row is
  // what the application uses and these values are only the bootstrap.
  //
  // Live sending and the blocked list are deliberately absent: they live on the screen alone,
  // and their defaults in code — off, and *@hubix.ro blocked — are the ones worth having.
  // Setting a list here would also append to that default rather than replace it.
  "Email": {
    // The address mail is sent as. It has to match the domain whose SPF, DKIM and DMARC
    // records are set up, or everything lands in spam — which for a two-day hold countdown
    // means a lost apartment. Deliberately not on the admin screen: the DNS has to move
    // with it, and a screen cannot do that.
    "From": "portal@example.invalid",
    "FromName": "Hubix Portal",

    // Every message is re-addressed here, with the intended recipient kept in the
    // subject and body. Set this to your own address for testing; leave it empty
    // in production.
    "RedirectAllTo": "your.address@example.com",

    // When live sending is on and this is non-empty, only these may be contacted.
    // Empty means everyone, which is what production wants.
    "AllowedRecipients": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  }
}
