@using System.Globalization
@using Hubix.Domain.Entities
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@culture.Split('-')[0]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Hubix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
        <div class="shell masthead-inner">
            <a class="wordmark" asp-page="/Index">
                HUBIX<span class="mark">Portal</span>
            </a>

            <nav aria-label="Main">
                <a asp-page="/Index">@L["Nav.Projects"]</a>

                <div class="lang" role="group" aria-label="@L["Nav.Language"]">
                    @foreach (var option in Cultures.Offered)
                    {
                        var isCurrent = culture.Equals(option, StringComparison.OrdinalIgnoreCase);
                        <a asp-page="/Language"
                           asp-route-culture="@option"
                           asp-route-returnUrl="@returnUrl"
                           aria-current="@(isCurrent ? "true" : null)"
                           hreflang="@option">@option.Split('-')[0]</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer>
        <div class="shell">
            Hubix · AFI Park 1, etaj 2, București · contact@@hubix.ro<br />
            Prices exclude VAT unless stated. Availability is live; a listing is not an offer.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
