@page "/projects/{slug}/waitlist"
@model Hubix.Web.Pages.Projects.WaitlistModel
@{
    ViewData["Title"] = $"{T["Waitlist.Heading"].Value} — {Model.ProjectName}";
}

<div class="shell">
    <p class="crumbs">
        <a asp-page="/Index">@L["Nav.Projects"]</a><span>/</span>
        <a asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a><span>/</span>
        @L["Waitlist.Heading"]
    </p>

    <div class="page-head">
        <p class="eyebrow">@Model.ProjectName</p>
        <h1>@L["Waitlist.Heading"]</h1>
        <p class="lede">
            @if (Model.FreeUnits > 0)
            {
                @L["Waitlist.SomeFree", Model.FreeUnits]
            }
            else
            {
                @L["Waitlist.NoneFree"]
            }
        </p>
    </div>

    @if (Model.FailureKey is { } failure)
    {
        <div class="alert" role="alert">@L[failure]</div>
    }

    <div class="form-wrap">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert"></div>

            <div class="field">
                <label asp-for="Input.Type">@L["Waitlist.WhichType"]</label>
                <select asp-for="Input.Type">
                    <option value="">@L["Waitlist.AnyType"]</option>
                    @foreach (var type in Model.Types)
                    {
                        <option value="@type.Canonical">@type.Label</option>
                    }
                </select>
                <span class="field-hint">@L["Waitlist.WhichTypeHint"]</span>
            </div>

            <div class="field">
                <label asp-for="Input.FullName">@L["Form.FullName"]</label>
                <input asp-for="Input.FullName" autocomplete="name" required />
                <span asp-validation-for="Input.FullName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Email">@L["Form.Email"]</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" required />
                <span class="field-hint">@L["Waitlist.EmailHint"]</span>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Phone">@L["Form.Phone"]</label>
                <input asp-for="Input.Phone" type="tel" autocomplete="tel" />
                <span asp-validation-for="Input.Phone" class="field-error"></span>
            </div>

            <div class="field checkbox">
                <label>
                    <input asp-for="Input.Consent" type="checkbox" required />
                    <span>@L["Waitlist.Consent"]</span>
                </label>
                <span asp-validation-for="Input.Consent" class="field-error"></span>
            </div>

            <button class="btn" type="submit">@L["Waitlist.Join"]</button>

            <p class="form-foot">@L["Waitlist.NoObligation"]</p>
        </form>
    </div>
</div>
