@page "/projects/{slug}/apartments/{code}/reserve"
@model Hubix.Web.Pages.Projects.ReserveModel
@{
    ViewData["Title"] = $"{T["Reserve.Action"].Value} {Model.UnitCode}";
}

<div class="shell">
    <p class="crumbs">
        <a asp-page="/Index">@L["Nav.Projects"]</a><span>/</span>
        <a asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a><span>/</span>
        <a asp-page="/Projects/Apartment" asp-route-slug="@Model.Slug" asp-route-code="@Model.UnitCode">@Model.UnitCode</a><span>/</span>
        @L["Reserve.Action"]
    </p>

    <div class="page-head">
        <p class="eyebrow">@Model.ProjectName · @Model.UnitCode</p>
        <h1>@L["Reserve.Heading"]</h1>
        <p class="lede">@L["Reserve.HoldExplainer", Model.HoldDurationHours]</p>
    </div>

    @if (Model.FailureKey is { } failure)
    {
        <div class="alert" role="alert">
            @L[failure, Model.FailureArgs]
        </div>

        <p style="margin-top:20px">
            <a class="btn ghost" asp-page="/Projects/Apartments" asp-route-slug="@Model.Slug">
                @L["Reserve.SeeWhatIsLeft"]
            </a>
        </p>
    }
    else
    {
        <div class="form-wrap">
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert"></div>

                <div class="field">
                    <label asp-for="Input.FullName">@L["Form.FullName"]</label>
                    <input asp-for="Input.FullName" autocomplete="name" required />
                    <span asp-validation-for="Input.FullName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email">@L["Form.Email"]</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" required />
                    <span class="field-hint">@L["Form.EmailHint"]</span>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Phone">@L["Form.Phone"]</label>
                    <input asp-for="Input.Phone" type="tel" autocomplete="tel" />
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>

                <div class="field checkbox">
                    <label>
                        <input asp-for="Input.Consent" type="checkbox" />
                        <span>@L["Form.Consent"]</span>
                    </label>
                    <span asp-validation-for="Input.Consent" class="field-error"></span>
                </div>

                <button class="btn" type="submit">@L["Reserve.Confirm"]</button>

                <p class="form-foot">
                    @if (Model.ReservationFee is { } fee)
                    {
                        @L["Reserve.FeeNote", Display.Money(fee)]
                        <text> </text>
                    }
                    @L["Reserve.NoPaymentNow"]
                </p>
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
