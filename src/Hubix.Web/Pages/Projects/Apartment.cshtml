@page "/projects/{slug}/apartments/{code}"
@model Hubix.Web.Pages.Projects.ApartmentModel
@{
    var u = Model.Unit;
    ViewData["Title"] = $"{u.Code} — {Model.ProjectName}";
}

<div class="shell">
    <p class="crumbs">
        <a asp-page="/Index">@L["Nav.Projects"]</a><span>/</span>
        <a asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a><span>/</span>
        <a asp-page="/Projects/Apartments" asp-route-slug="@Model.Slug">@L["Project.Apartments"]</a><span>/</span>
        @u.Code
    </p>

    <div class="page-head">
        <p class="eyebrow">@Model.TypeDisplay</p>
        <h1>@u.Code</h1>
        <p class="lede">
            <span class="state @(Model.IsFree ? "is-free" : "")">@L[Display.StateKey(u.State)]</span>
        </p>
    </div>

    <dl class="spec">
        @if (u.FloorLevel is { } level)
        {
            <div><dt>@L["Unit.Floor"]</dt><dd>@level</dd></div>
        }
        @if (u.Orientation is { Length: > 0 } orientation)
        {
            <div><dt>@L["Unit.Orientation"]</dt><dd>@orientation</dd></div>
        }
        <div>
            <dt>@L["Unit.AreaUsable"]</dt>
            <dd>@Display.Area(u.AreaUsable)</dd>
        </div>
        @if (u.AreaBalcony > 0)
        {
            <div><dt>@L["Unit.AreaBalcony"]</dt><dd>@Display.Area(u.AreaBalcony)</dd></div>
        }
        <div>
            <dt>@L["Unit.AreaTotal"]</dt>
            <dd>@Display.Area(u.AreaTotal)</dd>
        </div>
        <div>
            <dt>@L["Unit.PriceNet"]</dt>
            <dd>@Display.Money(u.BasePriceNet)</dd>
        </div>
    </dl>

    @if (Model.Schedule is { } schedule)
    {
        @* Every one of Hubix's sheets keeps the first payment in two columns: the advance on
           the apartment and the assignment price. Those are the two halves the buyer signs
           for separately, so the page shows them rather than one figure they cannot check. *@
        var advance = schedule.Tranches
            .FirstOrDefault(t => t.CesiuneNet > 0 && t.Percentage is not null);

        <div class="section">
            <p class="section-label">@L["Tranche.Schedule"]</p>

            <div class="schedule">
                @* Column headers, desktop only. Below 620px each figure carries its own
                   label via data-label, because the row stacks. *@
                <div class="tranche head" aria-hidden="true">
                    <div class="label"></div>
                    <div class="amt">@L["Tranche.Net"]</div>
                    <div class="amt">@L["Tranche.Vat"]</div>
                    <div class="amt">@L["Tranche.Gross"]</div>
                </div>

                @* The number comes from the position, not from the stored label: it is the
                   only way to say "Instalment 2" in the reader's language. *@
                @for (var i = 0; i < schedule.Tranches.Count; i++)
                {
                    var tranche = schedule.Tranches[i];

                    <div class="tranche">
                        <div class="label">
                            @L["Tranche.Number", i + 1]
                            <small>@L[Display.DueKey(tranche.Due)]</small>
                        </div>
                        <div class="amt" data-label="@T["Tranche.Net"].Value">@Display.MoneyExact(tranche.Net)</div>
                        <div class="amt" data-label="@T["Tranche.Vat"].Value">@Display.MoneyExact(tranche.Vat)</div>
                        <div class="amt total" data-label="@T["Tranche.Gross"].Value">@Display.MoneyExact(tranche.Gross)</div>
                    </div>

                    @* Two figures to show means a payment that collects the assignment price
                       alongside the apartment. Whether a rate describes the apartment half is
                       a separate question: the final payment is a remainder, not a rate. *@
                    @if (tranche.CesiuneNet > 0)
                    {
                        <div class="tranche part">
                            <div class="label">@(tranche.Percentage is { } pct
                                ? L["Tranche.Advance", (pct * 100).ToString("0.##")]
                                : L["Tranche.AdvanceNoRate"])</div>
                            <div class="amt" data-label="@T["Tranche.Net"].Value">@Display.MoneyExact(tranche.ApartmentNet)</div>
                            <div class="amt" data-label="@T["Tranche.Vat"].Value">@Display.MoneyExact(tranche.ApartmentVat)</div>
                            <div class="amt total" data-label="@T["Tranche.Gross"].Value">@Display.MoneyExact(tranche.ApartmentNet + tranche.ApartmentVat)</div>
                        </div>

                        <div class="tranche part">
                            <div class="label">@L["Tranche.Cesiune"]</div>
                            <div class="amt" data-label="@T["Tranche.Net"].Value">@Display.MoneyExact(tranche.CesiuneNet)</div>
                            <div class="amt" data-label="@T["Tranche.Vat"].Value">@Display.MoneyExact(tranche.CesiuneVat)</div>
                            <div class="amt total" data-label="@T["Tranche.Gross"].Value">@Display.MoneyExact(tranche.CesiuneNet + tranche.CesiuneVat)</div>
                        </div>
                    }
                }

                <p class="schedule-foot">
                    @L["Tranche.Explainer", (schedule.VatRate * 100).ToString("0.#"), (schedule.CesiuneVatRate * 100).ToString("0.#")]

                    @* The rate is measured against the price less the assignment price, which
                       is not the price shown above. Saying so is the difference between a
                       figure a buyer can reproduce and one that looks wrong. *@
                    @if (advance?.Percentage is { } advancePct)
                    {
                        @L["Tranche.AdvanceBasis", (advancePct * 100).ToString("0.##")]
                    }
                </p>
            </div>
        </div>
    }

    @if (Model.ShowParking)
    {
        <div class="section">
            <p class="section-label">@L["Parking.Heading"]</p>

            @* Same dl grid as the specification above: parking is another set of facts about
               the apartment, not a second payment schedule. A zero price is how the sheets
               say "no parking here", so it is not a figure to advertise. *@
            @if (u.ParkingPriceNet is > 0 || u.ParkingAdvanceNet is > 0 || u.ParkingSpaceKind is not null)
            {
                <dl class="spec">
                    @if (u.ParkingPriceNet is > 0)
                    {
                        <div>
                            <dt>@L["Unit.PriceNet"]</dt>
                            <dd>@Display.Money(u.ParkingPriceNet.Value)</dd>
                        </div>
                    }
                    @if (u.ParkingAdvanceNet is > 0)
                    {
                        <div>
                            <dt>@L["Parking.Advance"]</dt>
                            <dd>@Display.Money(u.ParkingAdvanceNet.Value)</dd>
                        </div>
                    }
                    @* Worth showing on its own: on a project where parking is bought from the
                       developer there is no price here, but which space still matters. *@
                    @if (u.ParkingSpaceKind is { } spaceKind)
                    {
                        <div>
                            <dt>@L["Parking.Space"]</dt>
                            <dd>@L[Display.ParkingSpaceKey(spaceKind)]</dd>
                        </div>
                    }
                </dl>
            }

            @* Why there is no price, or whatever else the project needs to say about parking. *@
            @if (Model.ParkingNote is { Length: > 0 } parkingNote)
            {
                <p class="note">@parkingNote</p>
            }
        </div>
    }

    @if (Model.Drawings.Count > 0)
    {
        <div class="section">
            <p class="section-label">@L["Asset.Drawings"]</p>

            @* Links are signed and expire, so nothing here is a permanent public address. *@
            <div class="drawings">
                @foreach (var drawing in Model.Drawings)
                {
                    <a class="drawing" href="@drawing.Url" target="_blank" rel="noreferrer">
                        @if (drawing.IsImage)
                        {
                            <img src="@drawing.Url" alt="@drawing.Title" loading="lazy" />
                        }
                        else
                        {
                            <span class="drawing-doc" aria-hidden="true">PDF</span>
                        }
                        <span class="drawing-title">@drawing.Title</span>
                    </a>
                }
            </div>
        </div>
    }

    <div class="section">
        @if (Model.IsFree)
        {
            <p class="note">@L["Reserve.HoldExplainer", Model.HoldDurationHours]</p>
            <p style="margin-top:16px">
                <a class="btn" asp-page="/Projects/Reserve"
                   asp-route-slug="@Model.Slug" asp-route-code="@u.Code">
                    @L["Reserve.Action"]
                </a>
            </p>
        }
        else
        {
            <p class="note">@L["Reserve.Unavailable"]</p>
        }
    </div>
</div>
