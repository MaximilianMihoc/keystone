<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hubix.Infrastructure\Hubix.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      As in Hubix.Infrastructure: so the tests can exercise internal helpers directly rather
      than widening the public API to suit them. ImportApi.RefuseUnreviewed is the case in
      point — it decides whether a commit may apply a workbook nobody reviewed, and the
      endpoint around it cannot be reached from Hubix.IntegrationTests, which does not
      reference this project.
    -->
    <InternalsVisibleTo Include="Hubix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AdminClientDir>$(MSBuildProjectDirectory)\..\Hubix.Admin</AdminClientDir>
    <UserSecretsId>bf3b32c7-9f9e-48c2-a7e4-774734737873</UserSecretsId>
  </PropertyGroup>

  <!--
    Build the React admin client as part of `dotnet build`, so one command produces a
    working application and nobody has to remember a second one.

    Inputs/Outputs make it incremental: npm runs only when a source file is newer than
    the bundle. Skipped entirely when npm is unavailable, so a machine without Node can
    still build and test the .NET side; the admin page then explains what to run.
  -->
  <!--
    Outside the target on purpose. Inputs="@(AdminClientSource)" is evaluated before the
    target runs, so an ItemGroup declared inside it resolves to nothing — and a target with
    no inputs and an output that exists is considered up to date for ever. That shipped a
    stale bundle from the moment index.js first appeared.
  -->
  <ItemGroup>
    <AdminClientSource Include="$(AdminClientDir)\src\**\*" />
    <AdminClientSource Include="$(AdminClientDir)\package.json" />
    <AdminClientSource Include="$(AdminClientDir)\vite.config.ts" />
    <AdminClientSource Include="$(AdminClientDir)\index.html" />
  </ItemGroup>

  <Target Name="BuildAdminClient"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(AdminClientDir)\package.json')"
          Inputs="@(AdminClientSource)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\admin-assets\index.js">

    <Exec Command="npm --version" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>

    <Message Importance="high"
             Condition="'$(NpmExitCode)' != '0'"
             Text="npm not found — skipping the admin client build. Run 'npm install &amp;&amp; npm run build' in src/Hubix.Admin when you have Node." />

    <Exec Condition="'$(NpmExitCode)' == '0' AND !Exists('$(AdminClientDir)\node_modules')"
          Command="npm install --no-fund --no-audit"
          WorkingDirectory="$(AdminClientDir)" />

    <Exec Condition="'$(NpmExitCode)' == '0'"
          Command="npm run build"
          WorkingDirectory="$(AdminClientDir)" />
  </Target>

</Project>
