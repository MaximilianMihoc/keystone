@page "/projects/{slug}/apartments/{code}/reserve"
@model Keystone.Web.Pages.Projects.ReserveModel
@{
    ViewData["Title"] = $"{T["Reserve.Action"].Value} {Model.UnitCode}";
}

<div class="shell">
    <p class="crumbs">
        <a asp-page="/Index">@L["Nav.Projects"]</a><span>/</span>
        <a asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a><span>/</span>
        <a asp-page="/Projects/Apartment" asp-route-slug="@Model.Slug" asp-route-code="@Model.UnitCode">@Model.UnitCode</a><span>/</span>
        @L["Reserve.Action"]
    </p>

    <div class="page-head">
        <p class="eyebrow">@Model.ProjectName · @Model.UnitCode</p>
        <h1>@L["Reserve.Heading"]</h1>
        <p class="lede">@L["Reserve.HoldExplainer", Model.HoldDurationHours]</p>
    </div>

    @* Whatever this project needs a buyer to read before committing. Shown above the failures
       as well as above the form: it is as true for somebody who lost the race as for anybody
       else, and they may well try the next apartment. *@
    @if (Model.Notice is { Length: > 0 } notice)
    {
        <div class="notice" role="note">
            <h2>@L["Reserve.NoticeHeading"]</h2>
            @foreach (var line in notice.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@line.Trim()</p>
            }
        </div>
    }

    @* Nothing is held yet. The apartment goes off sale only when the link in that email is
       followed, because anybody can type anybody's address into this form. *@
    @if (Model.Sent)
    {
        <div class="form-wrap" role="status">
            <p>@L["Reserve.CheckEmail"]</p>
            <p>
                <a class="btn ghost" asp-page="/Projects/Apartment"
                   asp-route-slug="@Model.Slug" asp-route-code="@Model.UnitCode">@Model.UnitCode</a>
            </p>
        </div>

        return;
    }

    @if (Model.FailureKey is { } failure)
    {
        <div class="alert" role="alert">
            @L[failure, Model.FailureArgs]
        </div>
    }

    @* A parking shortfall is the one failure the visitor can act on here: the apartment was
       never held, so the form comes back with the counts refreshed and they can take fewer
       spaces or none. Every other failure means this unit is gone, and the only honest thing
       left is a way back to the list. *@
    @if (Model.FailureKey is not null && !Model.CanRetry)
    {
        <p style="margin-top:20px">
            <a class="btn ghost" asp-page="/Projects/Apartments" asp-route-slug="@Model.Slug">
                @L["Reserve.SeeWhatIsLeft"]
            </a>
        </p>
    }
    else
    {
        <div class="form-wrap">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert"></div>

                <div class="field">
                    <label asp-for="Input.FirstName">@L["Form.FirstName"]</label>
                    <input asp-for="Input.FirstName" autocomplete="given-name" required />
                    <span asp-validation-for="Input.FirstName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Surname">@L["Form.Surname"]</label>
                    <input asp-for="Input.Surname" autocomplete="family-name" required />
                    <span asp-validation-for="Input.Surname" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email">@L["Form.Email"]</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" required />
                    <span class="field-hint">@L["Form.EmailHint"]</span>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Phone">@L["Form.Phone"]</label>
                    <input asp-for="Input.Phone" type="tel" autocomplete="tel" required />
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.City">@L["Form.City"]</label>
                    <input asp-for="Input.City" autocomplete="address-level2" required />
                    <span asp-validation-for="Input.City" class="field-error"></span>
                </div>

                @* Blank means Romania, which is nearly everybody. Asking the rest for a country
                   is one box more; asking everybody to pick from a list of two hundred is a
                   worse form for the sake of the rare case. *@
                <div class="field">
                    <label asp-for="Input.Country">@L["Form.Country"]</label>
                    <input asp-for="Input.Country" autocomplete="country-name" />
                    <span class="field-hint">@L["Form.CountryHint"]</span>
                    <span asp-validation-for="Input.Country" class="field-error"></span>
                </div>

                @* Only where the project sells parking and something is actually free. The
                   count is live but not a promise: the space is won in the same transaction
                   as the apartment, and the page says so if it has gone by then. *@
                @if (Model.ShowParking)
                {
                    <div class="field">
                        <label asp-for="Input.ParkingKind">@L["Parking.Choose"]</label>
                        <select asp-for="Input.ParkingKind">
                            <option value="">@L["Parking.None"]</option>
                            @foreach (var offer in Model.ParkingOnOffer)
                            {
                                <option value="@offer.Kind">
                                    @L[Display.ParkingSpaceKey(offer.Kind)] —
                                    @Display.Money(offer.PriceNet)
                                    (@L["Parking.Available", offer.Available])
                                </option>
                            }
                        </select>
                    </div>

                    @if (Model.MaxParkingSpaces > 1)
                    {
                        <div class="field">
                            <label asp-for="Input.ParkingQuantity">@L["Parking.Quantity"]</label>
                            <input asp-for="Input.ParkingQuantity" type="number"
                                   min="1" max="@Model.MaxParkingSpaces" />
                            <span asp-validation-for="Input.ParkingQuantity" class="field-error"></span>
                        </div>
                    }
                }

                <div class="field checkbox">
                    <label>
                        <input asp-for="Input.Consent" type="checkbox" required />
                        <span>@L["Form.Consent"]</span>
                    </label>
                    <span asp-validation-for="Input.Consent" class="field-error"></span>
                </div>

                <button class="btn" type="submit">@L["Reserve.Confirm"]</button>

                <p class="form-foot">
                    @if (Model.ReservationFee is { } fee)
                    {
                        @L["Reserve.FeeNote", Display.Money(fee)]
                        <text> </text>
                    }
                    @L["Reserve.NoPaymentNow"]
                </p>
            </form>
        </div>
    }
</div>
