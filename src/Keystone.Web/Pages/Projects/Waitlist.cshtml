@page "/projects/{slug}/waitlist"
@model Keystone.Web.Pages.Projects.WaitlistModel
@{
    ViewData["Title"] = $"{T["Waitlist.Heading"].Value} — {Model.ProjectName}";
}

<div class="shell">
    <p class="crumbs">
        <a asp-page="/Index">@L["Nav.Projects"]</a><span>/</span>
        <a asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a><span>/</span>
        @L["Waitlist.Heading"]
    </p>

    <div class="page-head">
        <p class="eyebrow">@Model.ProjectName</p>
        <h1>@L["Waitlist.Heading"]</h1>
        <p class="lede">
            @if (Model.FreeUnits > 0)
            {
                @L["Waitlist.SomeFree", Model.FreeUnits]
            }
            else
            {
                @L["Waitlist.NoneFree"]
            }
        </p>
    </div>

    @if (Model.Sent)
    {
        @* The same words whether they joined just now or were already on the list: this page
           must not tell whoever submitted the form which it was. *@
        <div class="form-wrap" role="status">
            <p>@L["Waitlist.Sent"]</p>
            <p><a class="btn" asp-page="/Projects/Detail" asp-route-slug="@Model.Slug">@Model.ProjectName</a></p>
        </div>
    }
    else
    {
        @if (Model.FailureKey is { } failure)
        {
            <div class="alert" role="alert">@L[failure]</div>
        }

        <div class="form-wrap">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert"></div>

                <div class="field">
                    <label asp-for="Input.Type">@L["Waitlist.WhichType"]</label>
                    <select asp-for="Input.Type">
                        <option value="">@L["Waitlist.AnyType"]</option>
                        @foreach (var type in Model.Types)
                        {
                            <option value="@type.Canonical">@type.Label</option>
                        }
                    </select>
                    <span class="field-hint">@L["Waitlist.WhichTypeHint"]</span>
                </div>

                <div class="field">
                    <label asp-for="Input.FirstName">@L["Form.FirstName"]</label>
                    <input asp-for="Input.FirstName" autocomplete="given-name" required />
                    <span asp-validation-for="Input.FirstName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Surname">@L["Form.Surname"]</label>
                    <input asp-for="Input.Surname" autocomplete="family-name" required />
                    <span asp-validation-for="Input.Surname" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email">@L["Form.Email"]</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" required />
                    <span class="field-hint">@L["Waitlist.EmailHint"]</span>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Phone">@L["Form.Phone"]</label>
                    <input asp-for="Input.Phone" type="tel" autocomplete="tel" required />
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.City">@L["Form.City"]</label>
                    <input asp-for="Input.City" autocomplete="address-level2" required />
                    <span asp-validation-for="Input.City" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Country">@L["Form.Country"]</label>
                    <input asp-for="Input.Country" autocomplete="country-name" />
                    <span class="field-hint">@L["Form.CountryHint"]</span>
                    <span asp-validation-for="Input.Country" class="field-error"></span>
                </div>

                <div class="field checkbox">
                    <label>
                        <input asp-for="Input.Consent" type="checkbox" required />
                        <span>@L["Waitlist.Consent"]</span>
                    </label>
                    <span asp-validation-for="Input.Consent" class="field-error"></span>
                </div>

                <button class="btn" type="submit">@L["Waitlist.Join"]</button>

                <p class="form-foot">@L["Waitlist.NoObligation"]</p>
            </form>
        </div>
    }
</div>
