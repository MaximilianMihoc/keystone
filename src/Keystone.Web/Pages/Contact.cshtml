@page "/contact"
@model Keystone.Web.Pages.ContactModel
@{
    ViewData["Title"] = T["Contact.Heading"].Value;
}

<div class="shell">
    <div class="page-head">
        <h1>@L["Contact.Heading"]</h1>
        <p class="lede">@L["Contact.Lede"]</p>
    </div>

    @if (Model.Sent is { } sent)
    {
        <div class="form-wrap">
            <p>@L["Contact.Sent"]</p>

            @if (sent != "General")
            {
                <p>@L["Contact.SentPrivacy"]</p>
            }

            <p><a class="btn" asp-page="/Index">@L["Nav.Projects"]</a></p>
        </div>
    }
    else
    {
        @if (Model.Failed)
        {
            <div class="alert" role="alert">@L["Contact.CouldNotSend"]</div>
        }

        <div class="form-wrap">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert"></div>

                <div class="field">
                    <label asp-for="Input.Kind">@L["Contact.Kind"]</label>
                    <select asp-for="Input.Kind">
                        <option value="General">@L["Contact.KindGeneral"]</option>
                        <option value="Access">@L["Contact.KindAccess"]</option>
                        <option value="Erasure">@L["Contact.KindErasure"]</option>
                    </select>
                    <span class="field-hint">@L["Contact.KindHint"]</span>
                </div>

                <div class="field">
                    <label asp-for="Input.Project">@L["Contact.Project"]</label>
                    <select asp-for="Input.Project">
                        <option value="">@L["Contact.NoProject"]</option>
                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Slug">@project.Name</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label asp-for="Input.FirstName">@L["Form.FirstName"]</label>
                    <input asp-for="Input.FirstName" autocomplete="given-name" required />
                    <span asp-validation-for="Input.FirstName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Surname">@L["Form.Surname"]</label>
                    <input asp-for="Input.Surname" autocomplete="family-name" />
                    <span asp-validation-for="Input.Surname" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Email">@L["Form.Email"]</label>
                    <input asp-for="Input.Email" type="email" autocomplete="email" required />
                    <span class="field-hint">@L["Contact.EmailHint"]</span>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Phone">@L["Form.Phone"]</label>
                    <input asp-for="Input.Phone" type="tel" autocomplete="tel" />
                    <span asp-validation-for="Input.Phone" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Message">@L["Contact.Message"]</label>
                    <textarea asp-for="Input.Message" rows="7" required></textarea>
                    <span asp-validation-for="Input.Message" class="field-error"></span>
                </div>

                <button class="btn" type="submit">@L["Contact.Send"]</button>

                <p class="form-foot">@L["Contact.PrivacyNote"]</p>
            </form>
        </div>
    }
</div>
