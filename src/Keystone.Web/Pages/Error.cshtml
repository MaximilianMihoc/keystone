@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Missing ? T["Error.MissingHeading"].Value : T["Error.Heading"].Value;
}

<div class="shell">
    <div class="page-head">
        <h1>@(Model.Missing ? L["Error.MissingHeading"] : L["Error.Heading"])</h1>
        <p class="lede">@(Model.Missing ? L["Error.MissingBody"] : L["Error.Body"])</p>
    </div>

    <p><a class="btn" asp-page="/Index">@L["Nav.Projects"]</a></p>

    @if (Model.ShowRequestId)
    {
        <p class="form-foot">@L["Error.Reference"] <code>@Model.RequestId</code></p>
    }
</div>
