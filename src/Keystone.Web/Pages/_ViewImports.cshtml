@using Keystone.Web
@using Keystone.Web.Pages
@using Keystone.Domain
@using Keystone.Domain.Entities
@using Keystone.Domain.Pricing
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@namespace Keystone.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@* Two localizers, and the difference matters.
   L renders into markup and formats its arguments as it writes.
   T returns a plain formatted string, for attributes, titles and ViewData.
   Calling .Value on L returns the RAW resource, so "Floor {0}" stays "Floor {0}". *@
@inject IHtmlLocalizer<SharedResource> L
@inject IStringLocalizer<SharedResource> T
