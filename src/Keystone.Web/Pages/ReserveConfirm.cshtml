@page "/reserve/{token}"
@model Keystone.Web.Pages.ReserveConfirmModel
@{
    ViewData["Title"] = T["Reserve.ConfirmHeading"].Value;
}

<div class="shell">
    <div class="page-head">
        @if (Model.Request is { } request)
        {
            <p class="eyebrow">@request.ProjectName · @request.UnitCode</p>
        }
        <h1>@L["Reserve.ConfirmHeading"]</h1>
    </div>

    @if (Model.FailureKey is { } failure)
    {
        <div class="alert" role="alert">@L[failure, Model.FailureArgs]</div>

        <p style="margin-top:20px">
            @if (Model.ProjectSlug is { Length: > 0 } slug)
            {
                <a class="btn ghost" asp-page="/Projects/Apartments" asp-route-slug="@slug">
                    @L["Reserve.SeeWhatIsLeft"]
                </a>
            }
            else
            {
                <a class="btn ghost" asp-page="/Index">@L["Nav.Projects"]</a>
            }
        </p>
    }
    else if (Model.Request is { } confirming)
    {
        <div class="form-wrap">
            <p>@L["Reserve.ConfirmExplain", confirming.UnitCode, confirming.ProjectName]</p>
            <p class="field-hint">@L["Reserve.HoldExplainer", confirming.HoldDurationHours]</p>

            <form method="post">
                <button class="btn" type="submit">@L["Reserve.ConfirmAction"]</button>
            </form>
        </div>
    }
</div>
